# Nunca coloque segredos reais neste arquivo.
# Copie para .env.local no computador que hospeda o HubUFRJ.

DATABASE_URL="file:./data/hubufrj.db"
APP_ORIGIN="https://SEU-HOST-PRIVADO"
SESSION_SECRET="GERAR_LOCALMENTE_UM_SEGREDO_FORTE"

# Acesso remoto recomendado: rede privada/VPN.
# Não publicar DATABASE_URL nem SESSION_SECRET com NEXT_PUBLIC_.
